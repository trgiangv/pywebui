<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>DepsSync</AssemblyName>
    <Description>Copies WebView2, Revit.Async, and Newtonsoft.Json into pywebui/bin.</Description>
    <BinDir>$(MSBuildThisFileDirectory)..\..\pywebui\bin\</BinDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" GeneratePathProperty="true">
      <IncludeAssets>none</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Revit.Async" Version="2.1.1" GeneratePathProperty="true">
      <IncludeAssets>none</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" GeneratePathProperty="true">
      <IncludeAssets>none</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="CopyDepsToPyrevitBin" AfterTargets="Build">
    <MakeDir Directories="$(BinDir)runtimes\win-x64\native\" />
    <ItemGroup>
      <_Remove Include="$(BinDir)WebViewBridge.dll" />
      <_Remove Include="$(BinDir)WebView2Loader.dll" />
    </ItemGroup>
    <Delete Files="@(_Remove)" ContinueOnError="true" />
    <Copy SourceFiles="$(PkgRevit_Async)\lib\net45\Revit.Async.dll" DestinationFolder="$(BinDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PkgNewtonsoft_Json)\lib\net45\Newtonsoft.Json.dll" DestinationFolder="$(BinDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll" DestinationFolder="$(BinDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Wpf.dll" DestinationFolder="$(BinDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.WinForms.dll" DestinationFolder="$(BinDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" DestinationFolder="$(BinDir)runtimes\win-x64\native\" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied WebView2, Revit.Async, and Newtonsoft.Json to $(BinDir)" />
  </Target>

</Project>
